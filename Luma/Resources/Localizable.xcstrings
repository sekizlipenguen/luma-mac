    },
    "Asked %@ to quit. CPU usage updates after it exits.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasına kapatma isteği gönderildi. CPU kullanımı uygulama çıktıktan sonra güncellenir."
          }
        }
      }
    },
    "This app has exited or cannot be quit from Luma.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama zaten kapandı veya Luma üzerinden kapatılamıyor."
          }
        }
      }
    },
    "%@ did not accept the quit request. Check the app for unsaved work.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapatma isteğini kabul etmedi. Kaydedilmemiş çalışmalar için uygulamayı kontrol edin."
          }
        }
      }
    },
    "Running Simulators & Emulators": {
      "extractionState": "manual",
      "localizations": {

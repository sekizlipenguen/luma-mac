    "Compare files that share the same size, then confirm with a full hash. Pick a minimum size before scanning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن الملفات ذات الحجم نفسه ثم يؤكد بتجزئة كاملة. اختر حدًا أدنى قبل الفحص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht Dateien gleicher Größe und bestätigt per Vollhash. Mindestgröße vor dem Scan wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare files that share the same size, then confirm with a full hash. Pick a minimum size before scanning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara archivos del mismo tamaño y confirma con un hash completo. Elige un tamaño mínimo antes de analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les fichiers de même taille, puis confirme par hachage complet. Choisissez une taille minimale avant l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta file della stessa dimensione e conferma con hash completo. Scegli una dimensione minima prima della scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じサイズのファイルを比較し、完全ハッシュで確認します。スキャン前に最小サイズを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 크기 파일을 비교한 뒤 전체 해시로 확인합니다. 스캔 전 최소 크기를 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara arquivos do mesmo tamanho e confirma com hash completo. Escolha um tamanho mínimo antes de analisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает файлы одного размера и подтверждает полным хешем. Выберите мин. размер перед сканированием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı boyuttaki dosyaları karşılaştırır, tam özetle doğrular. Taramadan önce minimum boyut seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较相同大小的文件，再用完整哈希确认。扫描前请选择最小大小。"
          }
        }
      }
    },

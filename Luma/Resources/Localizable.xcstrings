    "Keep Luma in the menu bar for quick access. Hiding the Dock icon turns Luma into an accessory app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ Luma في شريط القوائم للوصول السريع. إخفاء أيقونة Dock يجعله تطبيقًا مساعدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie Luma in der Menüleiste für schnellen Zugriff. Das Ausblenden des Dock-Symbols macht Luma zu einer Zubehör-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Luma in the menu bar for quick access. Hiding the Dock icon turns Luma into an accessory app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Luma en la barra de menús para acceso rápido. Ocultar el icono del Dock convierte Luma en una app accesoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Luma dans la barre de menus pour un accès rapide. Masquer l’icône du Dock fait de Luma une app accessoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Luma nella barra dei menu per un accesso rapido. Nascondere l’icona del Dock rende Luma un’app accessoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素早くアクセスできるようメニューバーに Luma を置きます。Dock アイコンを隠すとアクセサリアプリになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 접근을 위해 메뉴 막대에 Luma를 둡니다. Dock 아이콘을 숨기면 보조 앱이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Luma na barra de menus para acesso rápido. Ocultar o ícone do Dock torna o Luma um app acessório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите Luma в строке меню для быстрого доступа. Скрытие значка Dock делает Luma вспомогательным приложением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı erişim için Luma’yı menü çubuğunda tutun. Dock simgesini gizlemek Luma’yı yardımcı uygulamaya çevirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Luma 保留在菜单栏以便快速访问。隐藏 Dock 图标会将其变为辅助应用。"
          }
        }
      }
    },

    "System domain / SIP-protected — use Reveal in Finder. Luma will not modify system daemons.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطاق النظام / محمي بـ SIP — أظهر في Finder. Luma لا يعدّل خدمات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemdomäne / SIP-geschützt — im Finder zeigen. Luma ändert keine System-Daemons."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System domain / SIP-protected — use Reveal in Finder. Luma will not modify system daemons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dominio del sistema / protegido por SIP — Mostrar en el Finder. Luma no modifica daemons del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Domaine système / protégé par SIP — Afficher dans le Finder. Luma ne modifie pas les daemons système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dominio di sistema / protetto da SIP — Mostra nel Finder. Luma non modifica i daemon di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム領域 / SIP保護 — Finderで表示。Lumaはシステムデーモンを変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 도메인 / SIP 보호 — Finder에서 보기. Luma는 시스템 데몬을 수정하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Domínio do sistema / protegido por SIP — Mostrar no Finder. O Luma não altera daemons do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный домен / защита SIP — Показать в Finder. Luma не меняет системные демоны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem alanı / SIP korumalı — Finder’da Göster kullanın. Luma sistem daemon’larını değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统域 / SIP 保护 — 在 Finder 中显示。Luma 不会修改系统守护进程。"
          }
        }
      }
    },
    "System LaunchDaemons are listed but not modified (SIP). User LaunchAgents can be toggled with confirmation via launchctl.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض LaunchDaemons للنظام دون تعديل (SIP). يمكن تبديل LaunchAgents للمستخدم عبر launchctl مع تأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-LaunchDaemons werden gelistet, aber nicht geändert (SIP). User-LaunchAgents lassen sich mit Bestätigung per launchctl umschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System LaunchDaemons are listed but not modified (SIP). User LaunchAgents can be toggled with confirmation via launchctl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los LaunchDaemons del sistema se listan pero no se modifican (SIP). Los LaunchAgents de usuario se pueden alternar con confirmación vía launchctl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les LaunchDaemons système sont listés mais non modifiés (SIP). Les LaunchAgents utilisateur peuvent être basculés via launchctl avec confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I LaunchDaemon di sistema sono elencati ma non modificati (SIP). I LaunchAgent utente si possono attivare/disattivare con conferma via launchctl."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムLaunchDaemonは表示のみ（SIP）。ユーザーLaunchAgentはlaunchctlで確認付き切替可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 LaunchDaemon은 나열만 되며 수정되지 않습니다(SIP). 사용자 LaunchAgent는 launchctl로 확인 후 토글할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "LaunchDaemons do sistema são listados mas não alterados (SIP). LaunchAgents do usuário podem ser alternados com confirmação via launchctl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные LaunchDaemon перечисляются, но не меняются (SIP). Пользовательские LaunchAgent можно переключать через launchctl с подтверждением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem LaunchDaemon’ları listelenir ama değiştirilmez (SIP). Kullanıcı LaunchAgent’ları launchctl ile onaylı aç/kapa yapılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 LaunchDaemon 仅列出不修改（SIP）。用户 LaunchAgent 可通过 launchctl 确认后切换。"
          }
        }
      }
    },
    "Tap Estimate to calculate how much space the selection can free.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط تقدير لحساب المساحة التي يمكن تفريغها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Schätzen, um den freigebbaren Speicher zu berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Estimate to calculate how much space the selection can free."
          }
        },

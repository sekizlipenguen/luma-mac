    "Full Disk Access looks granted. Protected Library paths can be scanned.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن الوصول الكامل إلى القرص ممنوح. يمكن فحص مسارات Library المحمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff auf den Festplattenspeicher scheint erteilt. Geschützte Library-Pfade können gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access looks granted. Protected Library paths can be scanned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso completo al disco parece concedido. Se pueden escanear rutas de Library protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès complet au disque semble accordé. Les chemins Library protégés peuvent être analysés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso completo al disco sembra concesso. I percorsi Library protetti possono essere analizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスは許可されているようです。保護された Library パスをスキャンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근이 허용된 것으로 보입니다. 보호된 Library 경로를 스캔할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Acesso Total ao Disco parece concedido. Caminhos protegidos da Library podem ser analisados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, полный доступ к диску выдан. Защищённые пути Library можно сканировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi verilmiş görünüyor. Korumalı Library yolları taranabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎已授予完全磁盘访问权限。可以扫描受保护的 Library 路径。"
          }
        }
      }
    },

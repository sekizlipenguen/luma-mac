    "You can restore from Trash. Permanent delete is not used by default.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاستعادة من المهملات. الحذف النهائي ليس الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellen aus dem Papierkorb möglich. Dauerhaftes Löschen ist nicht Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore from Trash. Permanent delete is not used by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurar desde la papelera. El borrado permanente no se usa por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez restaurer depuis la corbeille. La suppression définitive n’est pas utilisée par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ripristinare dal Cestino. L’eliminazione permanente non è usata di default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱から復元できます。完全削除は既定ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 복원할 수 있습니다. 영구 삭제는 기본이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurar da Lixeira. A exclusão permanente não é o padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно восстановить из Корзины. Безвозвратное удаление по умолчанию не используется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp’ten geri yükleyebilirsiniz. Kalıcı silme varsayılan değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从废纸篓还原。默认不使用永久删除。"
          }
        }
      }
    },

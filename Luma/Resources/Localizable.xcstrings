    "Caches, downloads, developer folders, and apps — faster, focuses on space you can reclaim.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة التخزين المؤقت والتنزيلات ومجلدات المطورين والتطبيقات — أسرع ويركز على المساحة القابلة للاستعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, Downloads, Entwicklerordner und Apps — schneller, fokussiert auf freigebbaren Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, downloads, developer folders, and apps — faster, focuses on space you can reclaim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés, descargas, carpetas de desarrollo y apps: más rápido; enfocado en espacio recuperable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, téléchargements, dossiers développeur et apps — plus rapide, axe sur l’espace récupérable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, download, cartelle di sviluppo e app: più veloce, incentrato sullo spazio recuperabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、ダウンロード、開発フォルダ、アプリ — より高速。回収しやすい領域に焦点。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 다운로드, 개발 폴더, 앱 — 더 빠르며 확보 가능한 공간에 집중합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, downloads, pastas de desenvolvimento e apps — mais rápido; foca no espaço recuperável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши, загрузки, папки разработчика и приложения — быстрее, акцент на освобождаемом месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellek, indirmeler, geliştirici klasörleri ve uygulamalar — daha hızlı; geri kazanılabilir alana odaklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存、下载、开发者文件夹和应用 — 更快，关注可回收空间。"
          }
        }
      }
    },

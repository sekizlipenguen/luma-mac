    },
    "App totals include helper processes. 100% CPU equals one fully busy core.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama toplamlarına yardımcı süreçler dahildir. %100 CPU, bir çekirdeğin tam kullanımına eşittir."
          }
        }
      }
    },
    "Search CPU processes": {
      "extractionState": "manual",

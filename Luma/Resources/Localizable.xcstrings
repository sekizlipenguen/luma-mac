    "Scheduling installs a user LaunchAgent that opens Luma with --scheduled-cleanup. No cloud. Disable anytime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجدولة تثبّت LaunchAgent للمستخدم يفتح Luma بـ --scheduled-cleanup. بلا سحابة. عطّله في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Planung installiert einen User-LaunchAgent, der Luma mit --scheduled-cleanup öffnet. Keine Cloud. Jederzeit abschaltbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduling installs a user LaunchAgent that opens Luma with --scheduled-cleanup. No cloud. Disable anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La programación instala un LaunchAgent de usuario que abre Luma con --scheduled-cleanup. Sin nube. Desactívalo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La planification installe un LaunchAgent utilisateur qui ouvre Luma avec --scheduled-cleanup. Pas de cloud. Désactivable à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianificazione installa un LaunchAgent utente che apre Luma con --scheduled-cleanup. Niente cloud. Disattivabile quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールは --scheduled-cleanup でLumaを開くユーザーLaunchAgentを入れます。クラウドなし。いつでも無効化できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정은 --scheduled-cleanup으로 Luma를 여는 사용자 LaunchAgent를 설치합니다. 클라우드 없음. 언제든 끌 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agendamento instala um LaunchAgent do usuário que abre o Luma com --scheduled-cleanup. Sem nuvem. Desative quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расписание ставит пользовательский LaunchAgent, открывающий Luma с --scheduled-cleanup. Без облака. Можно отключить в любой момент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlama, Luma’yı --scheduled-cleanup ile açan bir kullanıcı LaunchAgent kurar. Bulut yok. İstediğiniz zaman kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划会安装用户 LaunchAgent，以 --scheduled-cleanup 打开 Luma。无云端。可随时关闭。"
          }
        }
      }
    },

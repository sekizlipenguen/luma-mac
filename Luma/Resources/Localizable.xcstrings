    "No two files share the same size above the threshold — so none can be duplicates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتشارك ملفان الحجم نفسه فوق الحد — لذا لا يمكن وجود نسخ مكررة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine zwei Dateien haben oberhalb der Schwelle dieselbe Größe — daher keine Duplikate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No two files share the same size above the threshold — so none can be duplicates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún par de archivos supera el umbral con el mismo tamaño — no puede haber duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier au-dessus du seuil ne partage la même taille — donc pas de doublons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna coppia sopra la soglia ha la stessa dimensione — quindi niente duplicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しきい値を超えて同じサイズのファイルがないため、重複はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임계값 이상에서 같은 크기인 파일이 없어 중복일 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum par acima do limite tem o mesmo tamanho — então não há duplicados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет двух файлов одинакового размера выше порога — дубликатов быть не может."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşik üstünde aynı boyutta iki dosya yok — bu yüzden kopya olamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阈值以上没有两个文件大小相同，因此不可能有重复。"
          }
        }
      }
    },

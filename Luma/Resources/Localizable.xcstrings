    "Without Full Disk Access, protected Library folders are skipped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون الوصول الكامل إلى القرص تُتخطى مجلدات Library المحمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne vollen Festplattenzugriff werden geschützte Library-Ordner übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access, protected Library folders are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso completo al disco se omiten las carpetas Library protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès complet au disque, les dossiers Library protégés sont ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza accesso completo al disco le cartelle Library protette vengono saltate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスがないと保護されたLibraryフォルダはスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근이 없으면 보호된 Library 폴더는 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso total ao disco, pastas Library protegidas são ignoradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без полного доступа к диску защищённые папки Library пропускаются."
          }
        },
        "tr": {

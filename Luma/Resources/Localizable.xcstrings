    "Try a lower minimum size, or add larger files to Downloads / Desktop / Documents.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب حدًا أدنى أصغر أو أضف ملفات أكبر إلى التنزيلات / سطح المكتب / المستندات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Mindestgröße wählen oder größere Dateien in Downloads / Schreibtisch / Dokumente legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a lower minimum size, or add larger files to Downloads / Desktop / Documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba un tamaño mínimo menor o añade archivos más grandes en Descargas / Escritorio / Documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une taille minimale plus basse, ou ajoutez de plus gros fichiers dans Téléchargements / Bureau / Documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova una soglia più bassa oppure aggiungi file più grandi in Download / Scrivania / Documenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小サイズを下げるか、ダウンロード / デスクトップ / 書類 に大きなファイルを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 크기를 낮추거나 Downloads / Desktop / Documents에 더 큰 파일을 넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente um tamanho mínimo menor ou coloque arquivos maiores em Downloads / Área de Trabalho / Documentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите меньший порог или положите более крупные файлы в Загрузки / Рабочий стол / Документы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha düşük minimum boyut seçin veya İndirilenler / Masaüstü / Belgeler’e daha büyük dosya koyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试更低的最小大小，或向“下载 / 桌面 / 文稿”放入更大的文件。"
          }
        }
      }
    },
    "Try a lower threshold (for example > 100 MB), or scan again after adding bigger files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب حدًا أدنى أصغر (مثل > 100 م.ب) أو افحص مجددًا بعد إضافة ملفات أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Schwelle versuchen (z. B. > 100 MB) oder nach dem Hinzufügen größerer Dateien erneut scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a lower threshold (for example > 100 MB), or scan again after adding bigger files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba un umbral menor (p. ej. > 100 MB) o vuelve a analizar tras añadir archivos más grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un seuil plus bas (ex. > 100 Mo), ou rattachez après avoir ajouté de plus gros fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova una soglia più bassa (es. > 100 MB) oppure analizza di nuovo dopo aver aggiunto file più grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しきい値を下げてみる（例: > 100 MB）。または大きなファイルを追加して再スキャン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 낮은 임계값(예: > 100 MB)을 쓰거나 더 큰 파일을 넣은 뒤 다시 스캔하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente um limite menor (ex.: > 100 MB) ou analise de novo depois de adicionar arquivos maiores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте меньший порог (например > 100 МБ) или просканируйте снова после добавления более крупных файлов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha düşük eşik deneyin (ör. > 100 MB) veya daha büyük dosya ekledikten sonra yeniden tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试更低阈值（例如 > 100 MB），或添加更大文件后再扫描。"
          }
        }
      }
    },

    "Allowlisted cleanups only. Default action moves to Trash so you can Undo from Finder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات تنظيف مسموحة فقط. الافتراضي إلى المهملات ويمكن التراجع من Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Allowlist-Bereinigungen. Standard ist Papierkorb — Rückgängig im Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowlisted cleanups only. Default action moves to Trash so you can Undo from Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo limpiezas de la lista permitida. Por defecto a la Papelera (Deshacer en el Finder)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyages sur liste blanche uniquement. Par défaut: corbeille (Annuler dans le Finder)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo pulizie in allowlist. L’azione predefinita va nel Cestino (Annulla da Finder)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可リストのクリーンアップのみ。既定はゴミ箱（Finderで取り消せます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 목록 정리만. 기본은 휴지통(Finder에서 실행 취소)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente limpezas na lista permitida. Padrão: Lixo (Desfazer no Finder)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только очистка из белого списка. По умолчанию — в Корзину (Отменить в Finder)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca izin listesindeki temizlikler. Varsayılan işlem Çöp’e taşır; Finder’dan Geri Alabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许列表中的清理。默认移到废纸篓，可在 Finder 中撤销。"
          }
        }
      }
    },

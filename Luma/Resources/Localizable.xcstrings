    "Totals include files inside the folder (allocated size). Large folders take a while — same walk as Storage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجمالي يشمل الملفات داخل المجلد (الحجم المخصص). المجلدات الكبيرة تستغرق وقتًا — نفس مسح التخزين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summe inkl. Dateien im Ordner (belegte Größe). Große Ordner dauern — derselbe Lauf wie Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Totals include files inside the folder (allocated size). Large folders take a while — same walk as Storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El total incluye los archivos dentro (tamaño asignado). Las carpetas grandes tardan: el mismo recorrido que Almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le total inclut les fichiers du dossier (taille allouée). Les gros dossiers prennent du temps — même parcours que Stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il totale include i file nella cartella (dimensione allocata). Le cartelle grandi richiedono tempo — stessa scansione di Archiviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計はフォルダ内のファイル（割り当てサイズ）です。大きなフォルダは時間がかかります。ストレージと同じ走査です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합계는 폴더 안 파일(할당 크기)입니다. 큰 폴더는 시간이 걸립니다. 저장공간과 같은 탐색입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O total inclui os arquivos da pasta (tamanho alocado). Pastas grandes demoram — o mesmo percurso do Armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итог включает файлы внутри (выделенный размер). Большие папки считаются долго — тот же обход, что и в Накопителе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam, klasörün içindeki dosyaları (ayrılmış boyut) kapsar. Büyük klasörler zaman alır — Depolama ile aynı yürüyüş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总计包含文件夹内的文件（占用空间）。大文件夹会较慢——与“存储”相同的遍历。"
          }
        }
      }
    },
    "Select a folder in Finder, then use Quick Actions / Services → Folder size in Luma.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مجلدًا في Finder ثم استخدم الإجراءات السريعة / الخدمات ← حجم المجلد في Luma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner im Finder wählen, dann Schnellaktionen / Dienste → Ordnergröße in Luma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a folder in Finder, then use Quick Actions / Services → Folder size in Luma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una carpeta en Finder y usa Acciones rápidas / Servicios → Tamaño de carpeta en Luma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un dossier dans le Finder, puis Actions rapides / Services → Taille du dossier dans Luma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una cartella nel Finder, poi Azioni rapide / Servizi → Dimensione cartella in Luma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでフォルダを選び、クイックアクション / サービス → Lumaでフォルダサイズ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 폴더를 선택한 뒤 빠른 동작 / 서비스 → Luma에서 폴더 크기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma pasta no Finder e use Ações rápidas / Serviços → Tamanho da pasta no Luma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку в Finder, затем Быстрые действия / Службы → Размер папки в Luma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da bir klasör seç, ardından Hızlı İşlemler / Servisler → Luma’da klasör boyutu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中选中文件夹，然后使用快速操作/服务 → 在 Luma 中查看文件夹大小。"
          }
        }
      }
    },
    "System paths are not measured (same rule as Storage).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسارات النظام لا تُقاس (نفس قاعدة التخزين)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systempfade werden nicht gemessen (gleiche Regel wie Speicher)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System paths are not measured (same rule as Storage)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas del sistema no se miden (la misma regla que Almacenamiento)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins système ne sont pas mesurés (même règle que Stockage)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percorsi di sistema non si misurano (stessa regola di Archiviazione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムパスは測定しません（ストレージと同じ規則）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 경로는 측정하지 않습니다(저장공간과 같은 규칙)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos do sistema não são medidos (mesma regra do Armazenamento)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные пути не измеряются (то же правило, что у Накопителя)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem yolları ölçülmez (Depolama ile aynı kural)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不测量系统路径（与“存储”相同规则）。"
          }
        }
      }
    },
    "No files were passed from Finder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُمرَّر أي ملف من Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder hat keine Dateien übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files were passed from Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder no envió ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier n’a été transmis par le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file è stato passato dal Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderからファイルが渡されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 파일이 전달되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo foi enviado pelo Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не передал файлы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder dosya göndermedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 没有传入文件。"
          }
        }
      }
    },
    "Luma cannot paint a GB label next to every folder in Finder’s list — Apple does not allow that. It can measure the folder you select.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Luma وضع تسمية غيغابايت بجانب كل مجلد في قائمة Finder — أبل لا تسمح بذلك. يمكنه قياس المجلد الذي تحدده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma kann in der Finder-Liste kein GB-Label neben jeden Ordner malen — Apple erlaubt das nicht. Es kann den ausgewählten Ordner messen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma cannot paint a GB label next to every folder in Finder’s list — Apple does not allow that. It can measure the folder you select."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma no puede poner una etiqueta de GB junto a cada carpeta en la lista de Finder: Apple no lo permite. Sí puede medir la carpeta seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma ne peut pas afficher un libellé Go à côté de chaque dossier dans la liste du Finder — Apple ne le permet pas. Il peut mesurer le dossier sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma non può mettere un’etichetta GB accanto a ogni cartella nell’elenco del Finder — Apple non lo consente. Può misurare la cartella selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LumaはFinderリストの各フォルダ横にGBラベルを描けません。Appleが許可していません。選択したフォルダは測定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma는 Finder 목록의 모든 폴더 옆에 GB 라벨을 그릴 수 없습니다. Apple이 허용하지 않습니다. 선택한 폴더는 측정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Luma não pode pintar um rótulo de GB ao lado de cada pasta na lista do Finder — a Apple não permite. Ele pode medir a pasta selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma не может нарисовать подпись ГБ у каждой папки в списке Finder — Apple этого не разрешает. Можно измерить выбранную папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma, Finder listesindeki her klasörün yanına GB yazamaz — Apple buna izin vermez. Seçtiğin klasörü ölçebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma 无法在 Finder 列表中给每个文件夹旁画上 GB 标签——苹果不允许。它可以测量你选中的文件夹。"
          }
        }
      }
    },
    "Right-click a folder → Quick Actions / Services → Folder size in Luma. Or enable the Luma Finder extension (toolbar + context menu). Finder itself can Calculate all sizes in list view options.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بزر أيمن على مجلد ← الإجراءات السريعة / الخدمات ← حجم المجلد في Luma. أو فعّل إضافة Finder لـ Luma. يمكن لـ Finder حساب كل الأحجام من خيارات عرض القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf einen Ordner → Schnellaktionen / Dienste → Ordnergröße in Luma. Oder die Luma-Finder-Erweiterung aktivieren. Der Finder selbst kann in den Listenoptionen alle Größen berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a folder → Quick Actions / Services → Folder size in Luma. Or enable the Luma Finder extension (toolbar + context menu). Finder itself can Calculate all sizes in list view options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic derecho en una carpeta → Acciones rápidas / Servicios → Tamaño de carpeta en Luma. O activa la extensión de Finder de Luma. Finder puede Calcular todos los tamaños en las opciones de lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic droit sur un dossier → Actions rapides / Services → Taille du dossier dans Luma. Ou activez l’extension Finder de Luma. Le Finder peut Calculer toutes les tailles dans les options de la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic destro su una cartella → Azioni rapide / Servizi → Dimensione cartella in Luma. Oppure attiva l’estensione Finder di Luma. Il Finder può Calcola tutte le dimensioni nelle opzioni elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを右クリック → クイックアクション / サービス → Lumaでフォルダサイズ。またはLumaのFinder拡張を有効に。Finder自体もリスト表示オプションでサイズを計算できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 오른쪽 클릭 → 빠른 동작 / 서비스 → Luma에서 폴더 크기. 또는 Luma Finder 확장 기능을 켜세요. Finder 자체도 목록 보기 옵션에서 모든 크기를 계산할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito numa pasta → Ações rápidas / Serviços → Tamanho da pasta no Luma. Ou ative a extensão do Finder do Luma. O próprio Finder pode Calcular todos os tamanhos nas opções de lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый клик по папке → Быстрые действия / Службы → Размер папки в Luma. Или включите расширение Finder для Luma. Сам Finder умеет «Вычислять все размеры» в параметрах списка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasöre sağ tık → Hızlı İşlemler / Servisler → Luma’da klasör boyutu. Ya da Luma Finder eklentisini aç. Finder’ın kendisi liste görünümü seçeneklerinde Tüm boyutları hesapla yapabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键文件夹 → 快速操作/服务 → 在 Luma 中查看文件夹大小。或启用 Luma 的 Finder 扩展。Finder 也可在列表显示选项中“计算所有大小”。"
          }
        }
      }
    },

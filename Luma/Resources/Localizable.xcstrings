    "About to free %@ · %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحرّر نحو %@ · %@. يمكنك الاستعادة من المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt etwa %@ · %@ frei. Wiederherstellen aus dem Papierkorb möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About to free %@ · %@. You can restore from Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberará unos %@ · %@. Puedes restaurar desde la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va libérer environ %@ · %@. Restauration possible depuis la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta per liberare circa %@ · %@. Puoi ripristinare dal Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ · %@ を解放します。ゴミ箱から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ · %@를 확보합니다. 휴지통에서 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai liberar cerca de %@ · %@. Você pode restaurar da Lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободит около %@ · %@. Можно восстановить из Корзины."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ · %@ boşalacak. Çöp’ten geri alabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将释放约 %@ · %@. 可从废纸篓还原。"
          }
        }
      }
    },

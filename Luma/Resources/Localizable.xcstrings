    "Pick a size threshold, then scan common user folders. You’ll always get a clear summary — even when nothing matches.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حد الحجم ثم افحص المجلدات الشائعة. ستحصل دائمًا على ملخص واضح حتى بلا نتائج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestgröße wählen, dann gängige Benutzerordner scannen. Sie bekommen immer eine klare Zusammenfassung — auch ohne Treffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a size threshold, then scan common user folders. You’ll always get a clear summary — even when nothing matches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un umbral y analiza carpetas habituales. Siempre verás un resumen claro, aunque no haya coincidencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un seuil, puis analysez les dossiers utilisateur courants. Vous aurez toujours un résumé clair — même sans résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una soglia, poi analizza le cartelle utente comuni. Avrai sempre un riepilogo chiaro — anche senza risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズのしきい値を選び、よく使うフォルダをスキャン。一致がなくても結果の要約が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 임계값을 고른 뒤 일반 사용자 폴더를 스캔하세요. 일치가 없어도 요약이 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um limite e analise pastas comuns. Você sempre verá um resumo claro — mesmo sem resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите порог размера и просканируйте обычные папки. Всегда будет понятная сводка — даже без совпадений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut eşiğini seçin, sonra yaygın kullanıcı klasörlerini tarayın. Eşleşme olmasa da net bir özet görürsünüz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择大小阈值，然后扫描常用用户文件夹。即使没有匹配也会有清晰摘要。"
          }
        }
      }
    },

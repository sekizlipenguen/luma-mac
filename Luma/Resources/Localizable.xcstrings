    "Swap grows when pressure is high. Quitting large apps is better than hoping for a magic clean.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزداد الـ Swap عند الضغط. إغلاق التطبيقات الكبيرة أفضل من تنظيف سحري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap wächst bei hohem Druck. Große Apps zu beenden ist besser als ein magischer Clean."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap grows when pressure is high. Quitting large apps is better than hoping for a magic clean."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El swap crece con alta presión. Cerrar apps grandes es mejor que una limpieza mágica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le swap augmente sous pression. Quitter de grosses apps vaut mieux qu’un nettoyage magique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo swap cresce sotto pressione. Chiudere app grandi è meglio di una pulizia magica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧力が高いとスワップが増えます。魔法のクリーンより大きなアプリを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압력이 높으면 스왑이 늘니다. 마법 청소보다 큰 앱을 종료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O swap cresce sob pressão. Fechar apps grandes é melhor que uma limpeza mágica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap растёт при давлении. Закрыть крупные приложения лучше «волшебной» очистки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basınç yüksekken takas artar. Büyük uygulamaları kapatmak sihirli temizleyiciden iyidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压力高时交换会增长。退出大型应用比指望魔法清理更好。"
          }
        }
      }
    },

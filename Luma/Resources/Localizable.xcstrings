    "SIP is enabled. This is normal for most Macs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP مفعّل. هذا طبيعي لمعظم أجهزة Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP ist aktiviert. Das ist für die meisten Macs normal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP is enabled. This is normal for most Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP está activado. Es lo habitual en la mayoría de los Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP est activé. C’est normal pour la plupart des Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP è attivo. È normale per la maggior parte dei Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIPは有効です。ほとんどのMacではこれが通常です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP가 켜져 있습니다. 대부분의 Mac에서 정상입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SIP está ativado. Isso é normal na maioria dos Macs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP включён. Так и должно быть на большинстве Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP açık. Çoğu Mac için bu normaldir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP 已启用。这对大多数 Mac 来说是正常状态。"
          }
        }
      }
    },
    "SIP appears disabled. That weakens macOS system protections — only keep it off if you intentionally need it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن SIP متوقف. هذا يضعف حمايات نظام macOS — اتركه متوقفًا فقط إذا احتجته عمدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP scheint deaktiviert. Das schwächt Systemschutz von macOS — nur absichtlich aus lassen, wenn nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP appears disabled. That weakens macOS system protections — only keep it off if you intentionally need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP parece desactivado. Eso debilita las protecciones del sistema de macOS: déjalo así solo si lo necesitas a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP semble désactivé. Cela affaiblit les protections système de macOS — ne le laissez désactivé que si vous en avez vraiment besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP sembra disattivato. Indebolisce le protezioni di sistema di macOS: lascialo così solo se ti serve intenzionalmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIPは無効のようです。macOSのシステム保護が弱まります。意図的に必要な場合だけオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP가 꺼진 것으로 보입니다. macOS 시스템 보호가 약해집니다. 의도적으로 필요할 때만 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SIP parece desativado. Isso enfraquece as proteções do sistema do macOS — deixe desativado só se precisar de propósito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP, похоже, отключён. Это ослабляет системные защиты macOS — оставляйте выключенным только если это нужно намеренно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP kapalı görünüyor. Bu, macOS sistem korumalarını zayıflatır — yalnızca bilerek gereken durumlarda kapalı bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIP 似乎已关闭。这会削弱 macOS 系统保护——仅在你确实需要时保持关闭。"
          }
        }
      }
    },

    "Stealth mode is on — the Mac may not respond to some unsolicited network probes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع التخفي مفعّل — قد لا يستجيب الـ Mac لبعض مسوحات الشبكة غير المطلوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealth-Modus ist an — der Mac antwortet möglicherweise nicht auf manche unaufgeforderte Netzwerksonden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealth mode is on — the Mac may not respond to some unsolicited network probes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo sigiloso está activado: el Mac puede no responder a algunas sondas de red no solicitadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode furtif est activé — le Mac peut ne pas répondre à certaines sondes réseau non sollicitées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità invisibile è attiva: il Mac potrebbe non rispondere ad alcune sonde di rete non richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステルスモードはオンです。一部の未要求ネットワーク探査に応答しない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스텔스 모드가 켜져 있습니다. 일부 원치 않는 네트워크 탐색에 응답하지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo furtivo está ativado — o Mac pode não responder a algumas sondas de rede não solicitadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый режим включён — Mac может не отвечать на некоторые непрошеные сетевые зонды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik modu açık — Mac bazı istenmeyen ağ yoklamalarına yanıt vermeyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐身模式已开启——Mac 可能不响应某些未经请求的网络探测。"
          }
        }
      }
    },
    "Stealth mode is off. Optional hardening, not a malware finding.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع التخفي متوقف. تقوية اختيارية، وليست اكتشاف برمجيات خبيثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealth-Modus ist aus. Optionale Härtung, kein Malware-Befund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealth mode is off. Optional hardening, not a malware finding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo sigiloso está desactivado. Endurecimiento opcional, no un hallazgo de malware."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode furtif est désactivé. Durcissement optionnel, pas une détection de malware."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità invisibile è disattivata. Rafforzamento opzionale, non un rilevamento malware."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステルスモードはオフです。任意の強化であり、マルウェア検出ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스텔스 모드가 꺼져 있습니다. 선택적 강화일 뿐 악성코드 발견이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo furtivo está desativado. Endurecimento opcional, não uma detecção de malware."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый режим выключен. Это необязательное усиление, не находка вредоносного ПО."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik modu kapalı. İsteğe bağlı sertleştirme; zararlı yazılım bulgusu değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐身模式已关闭。这是可选加固，不是恶意软件发现。"
          }
        }
      }
    },
    "Could not read stealth mode.": {
      "extractionState": "manual",
      "localizations": {

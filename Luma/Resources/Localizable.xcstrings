    },
    "Gatekeeper is assessing apps before they run (spctl).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper يقيّم التطبيقات قبل تشغيلها (spctl)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper prüft Apps vor dem Start (spctl)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper is assessing apps before they run (spctl)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper está evaluando las apps antes de ejecutarlas (spctl)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper évalue les apps avant leur exécution (spctl)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper valuta le app prima dell’esecuzione (spctl)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeperはアプリ実行前に評価しています（spctl）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper가 앱 실행 전에 평가합니다(spctl)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gatekeeper está avaliando apps antes de executá-las (spctl)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper проверяет приложения перед запуском (spctl)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper uygulamaları çalışmadan önce değerlendiriyor (spctl)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper 会在应用运行前进行评估（spctl）。"
          }
        }
      }
    },
    "Gatekeeper assessments appear disabled. Re-enable in System Settings unless you disabled them on purpose.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن تقييمات Gatekeeper متوقفة. أعد تفعيلها في إعدادات النظام ما لم تعطّلها عمدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper-Prüfungen scheinen deaktiviert. In den Systemeinstellungen wieder aktivieren, sofern nicht absichtlich aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper assessments appear disabled. Re-enable in System Settings unless you disabled them on purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las evaluaciones de Gatekeeper parecen desactivadas. Actívalas en Ajustes del Sistema salvo que las hayas desactivado a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les évaluations Gatekeeper semblent désactivées. Réactivez-les dans Réglages Système sauf si vous les avez désactivées volontairement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valutazioni di Gatekeeper sembrano disattivate. Riattivale in Impostazioni di Sistema se non le hai disabilitate di proposito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeperの評価は無効のようです。意図的でなければシステム設定で再有効化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper 평가가 꺼진 것으로 보입니다. 의도적으로 끈 것이 아니면 시스템 설정에서 다시 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As avaliações do Gatekeeper parecem desativadas. Reative nas Ajustes do Sistema, a menos que as tenha desativado de propósito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверки Gatekeeper, похоже, отключены. Включите снова в Системных настройках, если только вы не отключали их намеренно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper değerlendirmeleri kapalı görünüyor. Bilerek kapatmadıysanız Sistem Ayarları’ndan yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper 评估似乎已关闭。除非你有意关闭，请在“系统设置”中重新启用。"
          }
        }
      }
    },

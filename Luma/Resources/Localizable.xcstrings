    "Asked %@ to quit. Memory frees after it exits.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طُلب من %@ الإنهاء. تتحرر الذاكرة بعد الخروج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde zum Beenden aufgefordert. Speicher wird nach dem Exit frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked %@ to quit. Memory frees after it exits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió salir de %@. La memoria se libera al cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande de quitter %@ envoyée. La mémoire se libère après la sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta di uscita a %@. La memoria si libera dopo l’uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に終了を依頼しました。終了後にメモリが解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 종료를 요청했습니다. 종료 후 메모리가 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido para sair de %@. A memória libera após o encerramento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ предложено выйти. Память освободится после выхода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapanması istendi. Bellek çıktıktan sonra boşalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求 %@ 退出。退出后内存才会释放。"
          }
        }
      }
    },

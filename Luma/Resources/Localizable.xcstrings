    "Open sockets per app (not byte volume — macOS does not expose honest per-app rates via public APIs).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقابس مفتوحة لكل تطبيق (وليس حجم البايتات — لا يعرض macOS معدلات صادقة عبر واجهات عامة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Sockets pro App (kein Bytevolumen — macOS liefert keine ehrlichen Raten über öffentliche APIs)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open sockets per app (not byte volume — macOS does not expose honest per-app rates via public APIs)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sockets abiertos por app (no volumen — macOS no expone tasas honestas con APIs públicas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sockets ouverts par app (pas le volume — macOS n’expose pas de débits honnêtes via des API publiques)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Socket aperti per app (non il volume — macOS non espone tassi onesti via API pubbliche)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの開いているソケット（通信量ではない。公開APIでは正確なアプリ別速度は出ません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 열린 소켓(바이트량이 아님 — macOS는 공개 API로 정직한 앱별 속도를 제공하지 않음)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sockets abertos por app (não o volume — o macOS não expõe taxas honestas via APIs públicas)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

    "Quick cleanup runs Dry Run estimates only from the menu bar. Confirm full cleanup in the main window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنظيف السريع من شريط القوائم تقدير تجريبي فقط. أكّد التنظيف الكامل في النافذة الرئيسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellreinigung schätzt nur per Probelauf aus der Menüleiste. Volle Reinigung im Hauptfenster bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick cleanup runs Dry Run estimates only from the menu bar. Confirm full cleanup in the main window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza rápida solo estima (simulación) desde la barra de menús. Confirma en la ventana principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage rapide ne fait que des estimations (simulation) depuis la barre de menus. Confirmez dans la fenêtre principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia rapida stima solo (simulazione) dalla barra menu. Conferma nella finestra principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイッククリーンはメニューバーからのドライラン見積もりのみ。本実行はメインウィンドウで確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 정리는 메뉴 막대에서 미리보기 예상만 합니다. 실제 정리는 메인 창에서 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza rápida só estima (simulação) pela barra de menus. Confirme na janela principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая очистка из строки меню — только пробная оценка. Полную очистку подтвердите в главном окне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı temizlik menü çubuğundan yalnızca Kuru Çalıştırma tahminidir. Asıl temizlik ana pencerede onaylanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速清理仅从菜单栏做试运行估算。请在主窗口确认完整清理。"
          }
        }
      }
    },

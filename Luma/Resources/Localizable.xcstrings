    "Finds big files in Downloads, Documents, Desktop, and Movies. Cloud placeholders and package guts are skipped so the scan stays responsive.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على الملفات الكبيرة في التنزيلات والمستندات وسطح المكتب والأفلام. يتخطى عناصر السحابة ومحتويات الحزم لإبقاء الفحص سلسًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet große Dateien in Downloads, Dokumente, Schreibtisch und Filme. Cloud-Platzhalter und Paket-Inhalte werden übersprungen, damit der Scan flüssig bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds big files in Downloads, Documents, Desktop, and Movies. Cloud placeholders and package guts are skipped so the scan stays responsive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra archivos grandes en Descargas, Documentos, Escritorio y Películas. Se omiten marcadores en la nube y el interior de paquetes para que el análisis responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les gros fichiers dans Téléchargements, Documents, Bureau et Films. Les placeholders cloud et le contenu des paquets sont ignorés pour garder l’analyse fluide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova file grandi in Download, Documenti, Scrivania e Film. Segnaposto cloud e interiori dei pacchetti saltati per tenere la scansione reattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード、書類、デスクトップ、ムービーの大きなファイルを検出。応答性のためクラウドのプレースホルダとパッケージ内部はスキップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Documents, Desktop, Movies의 큰 파일을 찾습니다. 반응성을 위해 클라우드 자리 표시자와 패키지 내용은 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra arquivos grandes em Downloads, Documentos, Área de Trabalho e Filmes. Placeholders na nuvem e interior de pacotes são ignorados para manter a análise ágil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет крупные файлы в Загрузках, Документах, на Рабочем столе и в Фильмах. Облачные заглушки и содержимое пакетов пропускаются, чтобы сканирование не подвисало."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Belgeler, Masaüstü ve Filmler’deki büyük dosyaları bulur. Tarama akıcı kalsın diye bulut yer tutucuları ve paket içleri atlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“下载、文稿、桌面、影片”中查找大文件。会跳过云占位符和软件包内部，以保持扫描流畅。"
          }
        }
      }
    },
    "Finds big files in Downloads, Documents, Desktop, and Movies. Cloud placeholders are skipped when they would stall.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على الملفات الكبيرة في التنزيلات والمستندات وسطح المكتب والأفلام. يتخطى عناصر السحابة التي قد تعلق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet große Dateien in Downloads, Dokumente, Schreibtisch und Filme. Cloud-Platzhalter, die hängen würden, werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds big files in Downloads, Documents, Desktop, and Movies. Cloud placeholders are skipped when they would stall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra archivos grandes en Descargas, Documentos, Escritorio y Películas. Se omiten marcadores en la nube que se atascarían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les gros fichiers dans Téléchargements, Documents, Bureau et Films. Les placeholders cloud qui bloqueraient sont ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova file grandi in Download, Documenti, Scrivania e Film. I segnaposto cloud che si bloccherebbero vengono saltati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード、書類、デスクトップ、ムービーの大きなファイルを検出。停滞しそうなクラウドのプレースホルダはスキップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Documents, Desktop, Movies의 큰 파일을 찾습니다. 멈출 수 있는 클라우드 자리 표시자는 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra arquivos grandes em Downloads, Documentos, Área de Trabalho e Filmes. Placeholders na nuvem que travariam são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет крупные файлы в Загрузках, Документах, на Рабочем столе и в Фильмах. Облачные заглушки, которые зависают, пропускаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Belgeler, Masaüstü ve Filmler’deki büyük dosyaları bulur. Takılmaya yol açacak bulut yer tutucuları atlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“下载、文稿、桌面、影片”中查找大文件。会卡住的云占位符将被跳过。"
          }
        }
      }
    },
    "Finds identical files by size, then SHA-256 across your home folder and Applications. Full Disk Access unlocks protected Library paths. System stays off-limits.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",

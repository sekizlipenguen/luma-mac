    },
    "Sends a normal quit request to this app and lets it close its helpers. The app may ask you to save your work.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya normal kapatma isteği gönderilir; yardımcı süreçlerini uygulama kapatır. Kaydedilmemiş çalışmalarınız için onay isteyebilir."
          }
        }
      }
    },
    "Show processes for %@": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ süreçlerini göster"

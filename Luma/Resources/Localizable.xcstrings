    "Stops the selected virtual devices and interrupts tests running on them. Device data is kept; Xcode and Android Studio stay open.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen sanal cihazlar kapanır ve üzerlerindeki testler durur. Cihaz verileri korunur; Xcode ve Android Studio açık kalır."
          }
        }
      }
    },
    "%lld emulators stopped. Device data was preserved.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld emülatör kapatıldı. Cihaz verileri korundu."
          }
        }
      }
    },
    "iOS simulator status is unavailable. Check that Xcode is installed and configured.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {

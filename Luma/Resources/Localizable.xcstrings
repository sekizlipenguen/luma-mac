    "Memory pressure is %@. Consider quitting the largest apps listed above. Luma never fakes RAM cleaning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغط الذاكرة %@. فكّر بإغلاق أكبر التطبيقات أعلاه. Luma لا يزيّف تنظيف الذاكرة أبداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherdruck ist %@. Erwägen Sie, die größten Apps oben zu beenden. Luma fälscht keine RAM-Reinigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory pressure is %@. Consider quitting the largest apps listed above. Luma never fakes RAM cleaning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presión de memoria es %@. Considera cerrar las apps más grandes de arriba. Luma nunca finge limpiar la RAM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression mémoire est %@. Envisagez de quitter les plus grosses apps ci-dessus. Luma ne simule jamais un nettoyage RAM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione di memoria è %@. Considera di chiudere le app più grandi sopra. Luma non simula mai la pulizia RAM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ圧力は%@です。上の大きなアプリの終了を検討してください。Lumaは偽のRAM掃除をしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 압력은 %@입니다. 위 큰 앱을 종료하는 것을 고려하세요. Luma는 가짜 RAM 정리를 하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressão de memória é %@. Considere fechar os apps maiores acima. O Luma nunca finge limpar a RAM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давление памяти: %@. Рассмотрите закрытие крупнейших приложений выше. Luma никогда не имитирует очистку RAM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellek basıncı %@. Yukarıdaki en büyük uygulamaları kapatmayı düşünün. Luma asla sahte RAM temizliği yapmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存压力为 %@。可考虑退出上方占用最大的应用。Luma 从不伪造内存清理。"
          }
        }
      }
    },
    "Memory pressure looks normal. Cached/inactive memory is managed by macOS and is not waste.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغط الذاكرة يبدو طبيعياً. الذاكرة المؤقتة/غير النشطة يديرها macOS وليست هدراً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherdruck wirkt normal. Cache/inaktiver Speicher wird von macOS verwaltet und ist kein Abfall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory pressure looks normal. Cached/inactive memory is managed by macOS and is not waste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presión de memoria parece normal. La caché/inactiva la gestiona macOS y no es desperdicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression mémoire semble normale. Le cache/inactif est géré par macOS et n’est pas du gaspillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione di memoria sembra normale. Cache/inattiva è gestita da macOS e non è spreco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ圧力は正常です。キャッシュ/非アクティブはmacOSが管理し、無駄ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 압력이 정상입니다. 캐시/비활성 메모리는 macOS가 관리하며 낭비가 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressão de memória parece normal. Cache/inativa é gerida pelo macOS e não é desperdício."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давление памяти в норме. Кэш/неактивная память управляется macOS и не является мусором."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellek basıncı normal görünüyor. Önbellek/pasif bellek macOS tarafından yönetilir; israf değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存压力看起来正常。缓存/非活动内存由 macOS 管理，并非浪费。"
          }
        }
      }
    },

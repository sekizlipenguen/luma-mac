    "Manage other apps' Login Items in System Settings. Luma lists LaunchAgents/Daemons from disk.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر عناصر تسجيل الدخول للتطبيقات الأخرى في إعدادات النظام. يعرض Luma LaunchAgents/Daemons من القرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Login-Objekte anderer Apps in den Systemeinstellungen verwalten. Luma listet LaunchAgents/Daemons von der Festplatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage other apps' Login Items in System Settings. Luma lists LaunchAgents/Daemons from disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los elementos de inicio de otras apps en Ajustes del Sistema. Luma lista LaunchAgents/Daemons del disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les éléments d’ouverture des autres apps dans Réglages Système. Luma liste les LaunchAgents/Daemons du disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci gli elementi di login di altre app in Impostazioni di Sistema. Luma elenca LaunchAgent/Daemon dal disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他アプリのログイン項目はシステム設定で管理。Lumaはディスク上のLaunchAgent/Daemonを一覧表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 로그인 항목은 시스템 설정에서 관리하세요. Luma는 디스크의 LaunchAgent/Daemon을 나열합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie Itens de Login de outros apps em Ajustes do Sistema. O Luma lista LaunchAgents/Daemons do disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы входа других приложений — в Системных настройках. Luma перечисляет LaunchAgent/Daemon с диска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların Giriş Öğelerini Sistem Ayarları’nda yönetin. Luma diskteki LaunchAgent/Daemon’ları listeler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中管理其他应用的登录项。Luma 从磁盘列出 LaunchAgent/Daemon。"
          }
        }
      }
    },

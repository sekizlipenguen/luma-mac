    "Measure Caches, DerivedData, Simulators, Gradle, Docker, and Applications. No full-disk crawl.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس Caches و DerivedData والمحاكيات و Gradle و Docker والتطبيقات. بلا زحف كامل للقرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst Caches, DerivedData, Simulatoren, Gradle, Docker und Programme. Kein Vollplattenscan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure Caches, DerivedData, Simulators, Gradle, Docker, and Applications. No full-disk crawl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide Cachés, DerivedData, Simuladores, Gradle, Docker y Aplicaciones. Sin análisis de disco completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure Caches, DerivedData, Simulateurs, Gradle, Docker et Applications. Pas de scan disque complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura Cache, DerivedData, Simulatori, Gradle, Docker e Applicazioni. Nessuna scansione dell’intero disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches、DerivedData、シミュレータ、Gradle、Docker、Applications を計測します。ディスク全体は走査しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, DerivedData, 시뮬레이터, Gradle, Docker, Applications를 측정합니다. 전체 디스크 탐색은 하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede Caches, DerivedData, Simuladores, Gradle, Docker e Aplicativos. Sem varredura de disco inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет Caches, DerivedData, симуляторы, Gradle, Docker и Программы. Без полного обхода диска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekler, DerivedData, Simülatörler, Gradle, Docker ve Uygulamalar ölçülür. Tam disk taraması yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量 Caches、DerivedData、模拟器、Gradle、Docker 和应用。不做整盘扫描。"
          }
        }
      }
    },

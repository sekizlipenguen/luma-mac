    "Turkish is listed first among common languages. Changing language updates Luma everywhere immediately.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التركية أولاً بين اللغات الشائعة. تغيير اللغة يحدّث Luma في كل مكان فوراً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkisch steht unter den gängigen Sprachen oben. Sprachwechsel aktualisiert Luma überall sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkish is listed first among common languages. Changing language updates Luma everywhere immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El turco aparece primero entre los idiomas comunes. El cambio actualiza Luma en todas partes al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le turc est listé en premier parmi les langues courantes. Le changement met à jour Luma partout immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il turco è primo tra le lingue comuni. Il cambio aggiorna Luma ovunque subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う言語の中でトルコ語が先頭です。変更するとLuma全体がすぐに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 언어 중 터키어가 맨 위입니다. 바꾸면 Luma 전체가 바로 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O turco aparece primeiro entre os idiomas comuns. A mudança atualiza o Luma em todos os lugares imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Турецкий первым среди распространённых языков. Смена языка сразу обновляет Luma везде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaygın diller arasında Türkçe en üstte. Dil değişince Luma her yerde hemen güncellenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常用语言中土耳其语排在最前。更改后 Luma 各处会立即更新。"
          }
        }
      }
    },

    "Finds identical files by size, then SHA-256. Scans Downloads, Desktop, and Documents. Small files under the threshold are skipped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على ملفات متطابقة بالحجم ثم SHA-256. يفحص التنزيلات وسطح المكتب والمستندات. يتخطى الملفات دون الحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet identische Dateien zuerst per Größe, dann SHA-256. Scannt Downloads, Schreibtisch und Dokumente. Dateien unter der Schwelle werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds identical files by size, then SHA-256. Scans Downloads, Desktop, and Documents. Small files under the threshold are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra archivos idénticos por tamaño y luego SHA-256. Analiza Descargas, Escritorio y Documentos. Se omiten archivos bajo el umbral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les fichiers identiques par taille puis SHA-256. Analyse Téléchargements, Bureau et Documents. Les petits fichiers sous le seuil sont ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova file identici per dimensione, poi SHA-256. Analizza Download, Scrivania e Documenti. I file sotto soglia vengono saltati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズの後に SHA-256 で同一ファイルを検出。ダウンロード / デスクトップ / 書類を対象。しきい値未満はスキップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 다음 SHA-256으로 동일 파일을 찾습니다. Downloads, Desktop, Documents를 스캔하며 임계값 미만은 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra arquivos idênticos por tamanho e depois SHA-256. Analisa Downloads, Área de Trabalho e Documentos. Arquivos abaixo do limite são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет одинаковые файлы по размеру, затем SHA-256. Сканирует Загрузки, Рабочий стол и Документы. Мелкие ниже порога пропускаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce boyuta, sonra SHA-256’ya göre aynı dosyaları bulur. İndirilenler, Masaüstü ve Belgeler taranır. Eşik altı küçük dosyalar atlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先按大小再用 SHA-256 查找相同文件。扫描“下载、桌面、文稿”。低于阈值的小文件会跳过。"
          }
        }
      }
    },
